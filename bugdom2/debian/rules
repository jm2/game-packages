#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
VER := 4.0.0
POMME := c6a38eab19a11847024a13f9b3e2af0c2d908c3e
D := $(CURDIR)/debian/bugdom2

%:
	dh $@ --buildsystem=cmake --sourcedirectory=src --builddirectory=build

override_dh_auto_configure:
	debian/fetch-sources
	rm -rf src && mkdir src
	tar -xf Bugdom2-$(VER).tar.gz -C src --strip-components=1
	rmdir src/extern/Pomme && mkdir src/extern/Pomme
	tar -xf Pomme-$(POMME).tar.gz -C src/extern/Pomme --strip-components=1
	dh_auto_configure -- -Wno-dev

override_dh_auto_install:
	sh install.sh src build $(D) $(VER) bugdom2
	install -m644 src/LICENSE.md $(D)/usr/share/doc/bugdom2/
	install -m644 src/extern/Pomme/LICENSE.md $(D)/usr/share/doc/bugdom2/Pomme-LICENSE.md
	desktop-file-validate $(D)/usr/share/applications/bugdom2.desktop

override_dh_auto_clean:
	rm -rf src build
