# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=gamelaunch
pkgver=1.1.0
pkgrel=1
pkgdesc="Shared launcher for wine (umu/Proton or system wine + DXVK) and native game packages"
arch=('any')
url="https://github.com/jm2/linux-packages"
license=('0BSD')
depends=('bash')
optdepends=('umu-launcher: run Windows games through Proton (default backend)'
            'wine: system wine backend (GAMELAUNCH_RUNNER=wine)'
            'dxvk-bin: Direct3D 8-11 over Vulkan for the system wine backend')
source=("gamelaunch" "gamelaunch.conf.5.md" "LICENSE")
sha256sums=('6c80c1d2de4ca076feb509581f5fc8a5551aefbd397fe50e8e12bad205be3db2'
            'be94d5def9dd362be835ca902900726d236db20bf88c75cb19c4aadcad57317f'
            '6d3b473b559ad3816a3ca62bd6f59dc66a06eb89a0b237e79f3f8217a8a6a467')

package() {
    install -Dm755 gamelaunch -t "${pkgdir}/usr/bin/"
    install -Dm644 gamelaunch.conf.5.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    install -dm755 "${pkgdir}/usr/share/gamelaunch/games" "${pkgdir}/etc/gamelaunch/games"
}
