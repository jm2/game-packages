# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/codmw2/.*$
%global __requires_exclude_from ^/opt/codmw2/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           codmw2-wine-steam
Version:        r5292
Release:        1%{?dist}
Summary:        Call of Duty: Modern Warfare 2 multiplayer (IW4x) using Wine with data via Steam
License:        LicenseRef-Proprietary
URL:            https://iw4x.dev/
Source0:       build.sh
Source1:       codmw2.conf
Source2:       codmw2.desktop
Source3:       README.md
Source4:       https://github.com/iw4x/iw4x-client/releases/download/r5292/iw4x.dll#/iw4x-r5292.dll
Source5:       https://github.com/iw4x/iw4x-rawfiles/releases/download/v0.2.40/release.zip#/iw4x-rawfiles-v0.2.40.zip

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  icoutils
BuildRequires:  unzip
BuildRequires:  gbe-fork-bin
Requires:       gamelaunch
Requires:       gbe-fork-bin
%ifarch aarch64
Requires:       umu-launcher
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       (umu-launcher or wine)
%endif

%description
Call of Duty: Modern Warfare 2 multiplayer (IW4x) using Wine with data via Steam

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/codmw2.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - r5292-1
- Switch to gamelaunch and gbe-fork-bin
- Move from the dead XLabs IW4x to the maintained iw4x project (client r5292, rawfiles v0.2.40)
