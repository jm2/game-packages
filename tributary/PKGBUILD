# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=tributary
pkgver=0.7.2
pkgrel=2
pkgdesc="A high-performance, Rhythmbox-style media manager with unified local and remote backends"
arch=('x86_64' 'aarch64')
url="https://github.com/jm2/tributary"
license=('GPL-3.0-or-later')
depends=('dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk4>=4.16' 'hicolor-icon-theme' 'libadwaita>=1.6' 'libgcc'
         'pango' 'gstreamer' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav')
makedepends=('cargo' 'pkgconf')
# Upstream's release profile already strips the binary.
options=('!lto' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "install.sh")
sha256sums=('458abad839df47e3da6f2ed9ec151d662252473c36d5ae4d39c7d358ecbc1c0b'
            '80d6f18a01cd4d07dd2402f77967060abc92d29366d36ff5a166730d05f37220')

prepare() {
  cd "${pkgname}-${pkgver}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}-${pkgver}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo build --release --frozen
}

package() {
  sh install.sh "${srcdir}/${pkgname}-${pkgver}" "${pkgdir}"
  install -Dm644 "${pkgname}-${pkgver}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
