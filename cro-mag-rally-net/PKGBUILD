# Contributor: George Rawlinson <george@rawlinson.net.nz>

_pkgname=cro-mag-rally
pkgname="${_pkgname}-net"
pkgver=3.0.2
pkgrel=5
pkgdesc='The wildest racing game since man invented the wheel! Experimental LAN build.'
arch=('x86_64' 'aarch64')
url='https://github.com/jm2/CroMagRally'
license=('CC-BY-NC-SA-4.0' 'MIT')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'sdl3')
makedepends=('cmake' 'git')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
_commit='1345101db55ab1879b2e5caf11948b2beefc95fa'
source=("${_pkgname}::git+${url}.git#commit=${_commit}"
        'git+https://github.com/jm2/Pomme.git'
        "${_pkgname}.desktop"
        "${_pkgname}.sh"
        'install.sh')
sha256sums=('SKIP'
            'SKIP'
            '95fb5ad4d9371e4c1d0bcfd0df48146944fb161ae4ff94325050fbedc4ff85fc'
            '79fcbc20ec4176edc87fe617d0cdce311271cabb41d566031cf6380262bb628e'
            '7b54cab794eb7060726757d26b6e7bd2bb1cfaa91b2cdf0d28dab1023a6675d5')

prepare() {
  cd "${_pkgname}"

  # Point the Pomme submodule at makepkg's clone; the superproject pins the
  # commit. extern/gl4es is only used on Android/iOS and is not fetched.
  git submodule init extern/Pomme
  git config submodule.extern/Pomme.url "${srcdir}/Pomme"
  git -c protocol.file.allow=always submodule update extern/Pomme
}

build() {
  cmake -S "${_pkgname}" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  sh "${srcdir}/install.sh" "${srcdir}/${_pkgname}" "${srcdir}/build" "${pkgdir}" "${pkgver}" "${pkgname}"
  install -Dm644 "${_pkgname}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 "${_pkgname}/extern/Pomme/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/Pomme-LICENSE.md"
}
