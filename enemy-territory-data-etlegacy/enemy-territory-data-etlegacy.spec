# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/usr/share/enemy\-territory/.*$
%global __requires_exclude_from ^/usr/share/enemy\-territory/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           enemy-territory-data-etlegacy
Version:        2.60b
Release:        1%{?dist}
Summary:        Wolfenstein: Enemy Territory 2.60b data (pak0-pak2.pk3, ET: Legacy mirror)
License:        LicenseRef-Wolfenstein-ET-EULA
URL:            https://mirror.etlegacy.com/etmain/
Source0:       build.sh
Source1:       README.md
Source2:       https://mirror.etlegacy.com/etmain/pak0.pk3#/pak0.pk3
Source3:       https://mirror.etlegacy.com/etmain/pak1.pk3#/pak1.pk3
Source4:       https://mirror.etlegacy.com/etmain/pak2.pk3#/pak2.pk3
Source5:       https://mirror.etlegacy.com/ET-2.60b.zip#/ET-2.60b.zip

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Recommends:     etlegacy-bin
Provides:       enemy-territory-data = 2.60b
Conflicts:      enemy-territory-data

%description
The original data files of Wolfenstein: Enemy Territory 2.60b (pak0.pk3,
pak1.pk3 and pak2.pk3), the free stand-alone game by Splash Damage and id
Software, installed to /usr/share/enemy-territory/etmain. They are downloaded
from mirror.etlegacy.com/etmain, the copy the ET: Legacy client itself
downloads them from, and are identical to those in the 2.60b Linux full
installer. Play them with ET: Legacy (etlegacy-bin).

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

