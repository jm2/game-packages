# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/doom3/.*$
%global __requires_exclude_from ^/opt/doom3/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           doom3-data-gog
Version:        1.3.1
Release:        3%{?dist}
Summary:        Doom 3 and Resurrection of Evil data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/doom_3
Source0:       build.sh
Source1:       README.md
Source2:       setup_doom_3_1.3.1_(62814).exe
Source3:       setup_doom_3_1.3.1_(62814)-1.bin

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  innoextract
Provides:       doom3-data
Provides:       doom3xp-data
Conflicts:      doom3-data
Conflicts:      doom3xp-data

%description
Doom 3 and Resurrection of Evil data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1.3.1-3
- Link /usr/share/games/doom3 to /opt/doom3 for distribution dhewm3 builds (Debian)
- Conflict with the virtual doom3-data/doom3xp-data instead of naming the other source packages, like every Doom 3 data package (Windows lists the providers by name)
