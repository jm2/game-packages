#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
COMMIT := 1d9d18d733946d2315886410d6642f4977f0971b
D := $(CURDIR)/debian/prey2006-git
DOC := $(D)/usr/share/doc/prey2006-git
APPID := io.github.friskthefallenhuman.prey2006

%:
	dh $@

override_dh_auto_configure:
	debian/fetch-sources
	rm -rf src build && mkdir src
	tar -xf Prey2006-$(COMMIT).tar.gz -C src --strip-components=1

override_dh_auto_build:
	sh preymake.sh build src build

override_dh_auto_install:
	sh preymake.sh install src build $(D) prey2006-git
	install -m644 src/.github/COPYING.txt src/neo/libs/imgui/LICENSE.txt LicenseRef-Prey-SDK.txt $(DOC)/
	desktop-file-validate $(D)/usr/share/applications/$(APPID).desktop
	appstreamcli validate --no-net $(D)/usr/share/metainfo/$(APPID).metainfo.xml

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf src build
