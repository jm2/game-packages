# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=tributary-git
pkgver=0.7.2.r0.g1a61fd9
pkgrel=1
pkgdesc="A high-performance, Rhythmbox-style media manager (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/jm2/tributary"
license=('GPL-3.0-or-later')
depends=('dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk4>=4.16' 'hicolor-icon-theme' 'libadwaita>=1.6' 'libgcc'
         'pango' 'gstreamer' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav')
makedepends=('git' 'cargo' 'pkgconf')
provides=("tributary=${pkgver%%.r*}")
conflicts=('tributary')
# Upstream's release profile already strips the binary.
options=('!lto' '!debug')
source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${pkgname}"
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${pkgname}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo build --release --frozen
}

package() {
  cd "${pkgname}"
  local _id=io.github.jm2.tributary
  install -Dm755 target/release/tributary -t "${pkgdir}/usr/bin/"
  install -Dm644 "data/${_id}.desktop" -t "${pkgdir}/usr/share/applications/"
  install -Dm644 "data/${_id}.metainfo.xml" -t "${pkgdir}/usr/share/metainfo/"
  local _size
  for _size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "data/icons/hicolor/${_size}x${_size}/apps/${_id}.png" \
      -t "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/"
  done
  install -Dm644 "data/icons/hicolor/scalable/actions/${_id}-equalizer-symbolic.svg" \
    -t "${pkgdir}/usr/share/icons/hicolor/scalable/actions/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
