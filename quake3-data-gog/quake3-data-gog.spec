# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/quake3/.*$
%global __requires_exclude_from ^/opt/quake3/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           quake3-data-gog
Version:        1
Release:        7%{?dist}
Summary:        Quake III Arena and Team Arena data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/quake_iii_gold
Source0:       build.sh
Source1:       README.md
Source2:       setup_quake3_2.0.0.2.exe

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  innoextract
Requires:       quake3-pointrelease-data
Provides:       quake3-data
Provides:       quake3-ta-data
Conflicts:      quake3-data
Conflicts:      quake3-ta-data
Conflicts:      quake3-ta-data-steam

%description
Quake III Arena and Team Arena data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1-7
- Generated from package.toml
- Also provide quake3-ta-data (Team Arena is included)
- Depend on quake3-pointrelease-data for the 1.32 point release paks
- Conflict with the virtual quake3-data/quake3-ta-data instead of naming the other source packages, like every Quake III data package (Windows lists the providers by name)
- Rebuilt without set-group-ID bits on its directories, which made RPM refuse to install it beside its engine package
