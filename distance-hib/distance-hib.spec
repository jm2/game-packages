# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/distance/.*$
%global __requires_exclude_from ^/opt/distance/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           distance-hib
Version:        6895
Release:        2%{?dist}
Summary:        Distance (native Linux) with data via Humble Bundle
License:        LicenseRef-Proprietary
URL:            https://www.humblebundle.com/store/distance
Source0:       build.sh
Source1:       distance.conf
Source2:       distance.desktop
Source3:       README.md
Source4:       distance_6895_linux.tar.gz

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  bsdtar
Requires:       gamelaunch
%ifarch aarch64
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       mesa-libGL
Requires:       libX11
Requires:       libXext
%endif

%description
Distance (native Linux) with data via Humble Bundle

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/distance.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 6895-2
- Switch to gamelaunch; define a hib:// handler with download instructions
