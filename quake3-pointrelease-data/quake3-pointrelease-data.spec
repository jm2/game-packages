# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/quake3/.*$
%global __requires_exclude_from ^/opt/quake3/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           quake3-pointrelease-data
Version:        1.32b
Release:        2%{?dist}
Summary:        Quake III Arena 1.32 point release paks (pak1-8, Team Arena pak1-3)
License:        LicenseRef-Quake3-PointRelease-EULA
URL:            https://ftp.gwdg.de/pub/misc/ftp.idsoftware.com/idstuff/quake3/linux/
Source0:       build.sh
Source1:       README.md
Source2:       https://ftp.gwdg.de/pub/misc/ftp.idsoftware.com/idstuff/quake3/linux/linuxq3apoint-1.32b-3.x86.run#/linuxq3apoint-1.32b-3.x86.run

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  tar
BuildRequires:  gzip
Recommends:     quake3e

%description
The data files of id Software's Quake III Arena 1.32 point release:
baseq3/pak1.pk3 to pak8.pk3 and missionpack/pak1.pk3 to pak3.pk3, installed
to /opt/quake3 next to the retail pak0.pk3 files of the quake3-data packages.
Pure servers require them. They are unpacked from id's Linux point release
installer (linuxq3apoint-1.32b-3.x86.run) without running it.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1.32b-2
- Initial package: 1.32 point release paks from id's Linux installer
- Rebuilt without set-group-ID bits on its directories, which made RPM refuse to install it beside its engine package
