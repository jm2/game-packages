# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/rvgl/packs/rvgl_dcpack/.*$
%global __requires_exclude_from ^/opt/rvgl/packs/rvgl_dcpack/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           rvgl-dcpack
Version:        23.0501a1
Release:        1%{?dist}
Summary:        Dreamcast content pack for RVGL (Rooftops and 14 cars)
License:        LicenseRef-Proprietary
URL:            https://rvgl.org
Source0:       build.sh
Source1:       README.md
Source2:       https://distribute.re-volt.io/packs/rvgl_dcpack.zip#/rvgl_dcpack-23.0501a1.zip

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Recommends:     rvgl-bin

%description
The content of the Dreamcast version of Re-Volt for RVGL: the Rooftops track
and 14 additional cars (including BigVolt and BossVolt), with the Dreamcast
car selection layout. Installed as RVGL's rvgl_dcpack pack in
/opt/rvgl/packs/rvgl_dcpack, downloaded at build time from Re-Volt I/O.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

