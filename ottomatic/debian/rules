#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
VER := 4.0.1
POMME := ad9cc177d2187f67bd00cb6cf2b3045ef91c577b
D := $(CURDIR)/debian/ottomatic

%:
	dh $@ --buildsystem=cmake --sourcedirectory=src --builddirectory=build

override_dh_auto_configure:
	debian/fetch-sources
	rm -rf src && mkdir src
	tar -xf ottomatic-$(VER).tar.gz -C src --strip-components=1
	rmdir src/extern/Pomme && mkdir src/extern/Pomme
	tar -xf Pomme-$(POMME).tar.gz -C src/extern/Pomme --strip-components=1
	patch -d src/extern/Pomme -p1 < pomme-cstdint.patch
	dh_auto_configure -- -Wno-dev

override_dh_auto_install:
	sh install.sh src build $(D) $(VER) ottomatic
	install -m644 src/LICENSE.md $(D)/usr/share/doc/ottomatic/
	install -m644 src/extern/Pomme/LICENSE.md $(D)/usr/share/doc/ottomatic/Pomme-LICENSE.md
	desktop-file-validate $(D)/usr/share/applications/ottomatic.desktop

override_dh_auto_clean:
	rm -rf src build
