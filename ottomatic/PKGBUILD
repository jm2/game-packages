# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>
# Contributor: George Rawlinson <george@rawlinson.net.nz>

pkgname=ottomatic
pkgver=4.0.1
pkgrel=1
pkgdesc='Save Earth from the clutches of The Giant Brain from Planet X'
arch=('x86_64' 'aarch64')
url='https://github.com/jorio/ottomatic'
license=('CC-BY-NC-SA-4.0' 'MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd' 'libstdc++' 'sdl2-compat' 'sh')
makedepends=('cmake')
# Release tarballs; GitHub archives don't include the Pomme submodule, so it is
# fetched separately at the commit the release records.
source=("ottomatic-4.0.1.tar.gz::https://github.com/jorio/ottomatic/archive/4.0.1/ottomatic-4.0.1.tar.gz"
        "Pomme-ad9cc177d2187f67bd00cb6cf2b3045ef91c577b.tar.gz::https://github.com/jorio/Pomme/archive/ad9cc177d2187f67bd00cb6cf2b3045ef91c577b/Pomme-ad9cc177d2187f67bd00cb6cf2b3045ef91c577b.tar.gz"
        'ottomatic.desktop'
        'ottomatic.sh'
        'install.sh'
        'pomme-cstdint.patch')
sha256sums=('6d9abaebf5c4d101370855c8f70d17cc83429964cf8882a28a5bed63b5b6a110'
            'ab70d32efe83687d07fcfb85983ffa6215e68fa7b0b6c2c2a9363ee2c3061c0b'
            'e03df46e72b4e24098d47323d3beba927869a477e9ead5330d844fa0c7316198'
            'ed6bc9fb3a1db928016a462aa0a2390690e1781931ea2f1fcf7008266e0e2ef2'
            '0787cb86c0ff5f0d1a553eb4921a62bc84de40acd24cabffed85652d7348086a'
            'e872a562db3a239c09dc13add53f010d57ded562d405b93d0552e495ca1c1f17')

prepare() {
  rmdir "OttoMatic-4.0.1/extern/Pomme"
  mkdir "OttoMatic-4.0.1/extern/Pomme"
  tar -xf "Pomme-ad9cc177d2187f67bd00cb6cf2b3045ef91c577b.tar.gz" -C "OttoMatic-4.0.1/extern/Pomme" --strip-components=1
  # <cstdint> includes for GCC 13+, from Pomme d57c28e (later Pomme commits
  # have it; this release pins an older one).
  patch -d "OttoMatic-4.0.1/extern/Pomme" -p1 < pomme-cstdint.patch
}

build() {
  cmake -S "OttoMatic-4.0.1" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  sh "${srcdir}/install.sh" "${srcdir}/OttoMatic-4.0.1" "${srcdir}/build" "${pkgdir}" "${pkgver}" "${pkgname}"
  install -Dm644 "OttoMatic-4.0.1/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 "OttoMatic-4.0.1/extern/Pomme/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/Pomme-LICENSE.md"
}
