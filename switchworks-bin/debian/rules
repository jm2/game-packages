#!/usr/bin/make -f
export DH_VERBOSE = 1
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
VERSION := 0.1.7
D := debian/switchworks-bin

%:
	dh $@

# Upstream's release .deb for the host architecture, unpacked.
override_dh_auto_build:
	debian/fetch-sources
	rm -rf release && dpkg-deb -x switchworks-$(VERSION)-release-$(DEB_HOST_ARCH).deb release

# The web UI built into swk embeds the Onest and JetBrains Mono fonts; their
# OFL texts go to the doc directory (see debian/copyright).
override_dh_auto_install:
	sh install.sh release $(D) usr/share/doc/switchworks-bin

# Like upstream's .deb: nothing is enabled or started at install; the system
# coordinator is restarted on upgrade if it runs.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --restart-after-upgrade

# dh_installsystemduser would enable the node and coordinator user units for
# every user; each user turns on the node with "swk service install".
override_dh_installsystemduser:

override_dh_auto_test:
	release/usr/bin/swk version | grep -F "v$(VERSION) "

# Upstream's static, stripped Go binaries: keep them as shipped.
override_dh_strip override_dh_dwz override_dh_shlibdeps:

override_dh_auto_clean:
	rm -rf release
