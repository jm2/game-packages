#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
VER := 1.3.4
POMME := ef94150e2dcec522e3099f4d03a4e8f2639f7232
D := $(CURDIR)/debian/bugdom

%:
	dh $@ --buildsystem=cmake --sourcedirectory=src --builddirectory=build

override_dh_auto_configure:
	debian/fetch-sources
	rm -rf src && mkdir src
	tar -xf Bugdom-$(VER).tar.gz -C src --strip-components=1
	rmdir src/extern/Pomme && mkdir src/extern/Pomme
	tar -xf Pomme-$(POMME).tar.gz -C src/extern/Pomme --strip-components=1
	dh_auto_configure -- -Wno-dev

override_dh_auto_install:
	sh install.sh src build $(D) $(VER) bugdom
	install -m644 src/LICENSE.md $(D)/usr/share/doc/bugdom/
	install -m644 src/extern/Pomme/LICENSE.md $(D)/usr/share/doc/bugdom/Pomme-LICENSE.md
	desktop-file-validate $(D)/usr/share/applications/bugdom.desktop

override_dh_auto_clean:
	rm -rf src build
