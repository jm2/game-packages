_build=1283
_commit=8c61d73988ff3c1a30a001bdc798ac7833376c5e
pkgver=${_ver}.b${_build}
pkgrel=1
pkgdesc="Bridge that lets Minecraft: Bedrock Edition clients join Minecraft: Java Edition servers (standalone jar)"
arch=('any')
url="https://geysermc.org/"
