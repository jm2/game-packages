pkgname=geysermc-bin
_ver=2.12.1
_build=1310
_commit=c8ce5d422bb48223b55ec5d13c0c7672f39eb868
pkgver=${_ver}.b${_build}
pkgrel=1
pkgdesc="Bridge that lets Minecraft: Bedrock Edition clients join Minecraft: Java Edition servers (standalone jar)"
arch=('any')
url="https://geysermc.org/"
license=('MIT')
depends=('java-runtime-headless>=21')
provides=('geysermc')
conflicts=('geysermc')
backup=('etc/geysermc/config.yml')
source=("Geyser-Standalone-${_ver}-b${_build}.jar::https://download.geysermc.org/v2/projects/geyser/versions/${_ver}/builds/${_build}/downloads/standalone"
        "LICENSE-${_commit}::https://raw.githubusercontent.com/GeyserMC/Geyser/${_commit}/LICENSE"
        "install.sh"
        "config.yml"
        "geysermc.service"
        "geysermc.sysusers"
        "geysermc.tmpfiles"
        "README.md")
noextract=("Geyser-Standalone-${_ver}-b${_build}.jar")
sha256sums=('b9270ec4379d1e2b59d44411e6474b2a94fc4b9eec1bdc5a83c1f498924b4e4d'
            '7421fa1da9de486b73147a11a0facdc7994c03b3d502720a2e269d944055595a'
            '0d19a1e970ebe1ac30312b0b207e9cde4108042ee3f938e2b5fe57a6bf50c232'
            'dc09cd9677195159413b679a12ba003dfb8613a75c685cadbd433c29389a2a7f'
            'be0d0a4f4c33d68f5ba6d5434722b8d101f0c727f0bd7e3df7bdec848701c235'
            'baaa43f0501c3d193d8fe9f9372eb97180e9393859f288413aac6cb477361727'
            '5a779dc12a2606e24b8848fb4b9b2f303475d8a256ac685ac93c45792595e217'
            '47276e4c9c4c3def5a38cbf0a8507f1497dd95f859d741f663e9547c3f260ec0')

package() {
  sh install.sh "${srcdir}" "Geyser-Standalone-${_ver}-b${_build}.jar" "${pkgdir}" "${pkgname}"
  install -Dm644 "LICENSE-${_commit}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
