        "install.sh"
        "config.yml"
        "geysermc.service"
        "geysermc.sysusers"
        "geysermc.tmpfiles"
        "README.md")
noextract=("Geyser-Standalone-${_ver}-b${_build}.jar")
sha256sums=('2b1c47c62d209695e2f1abbfca193d5db30d71f42cb0b661a22435651aacee92'
            '7421fa1da9de486b73147a11a0facdc7994c03b3d502720a2e269d944055595a'
