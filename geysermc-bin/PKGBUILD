        "install.sh"
        "config.yml"
        "geysermc.service"
        "geysermc.sysusers"
        "geysermc.tmpfiles"
        "README.md")
noextract=("Geyser-Standalone-${_ver}-b${_build}.jar")
sha256sums=('fcd8cd26f3e4a1180ee3828b6c63ed3b90e78c99c7ccc2cbba3b12f303d705b9'
            '7421fa1da9de486b73147a11a0facdc7994c03b3d502720a2e269d944055595a'
