# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/aoe3/.*$
%global __requires_exclude_from ^/opt/aoe3/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           aoe3-wine-steam
# Version of the cached Steam download (tools/fetch-steam): <game version>.b<Steam build ID>.
Version:        %(PT_SRCDIR=%{_sourcedir} PT_WORK=/nonexistent bash %{_sourcedir}/build.sh version 2>/dev/null || echo 0)
Release:        3%{?dist}
Summary:        Age of Empires III (2007) Complete Collection using Wine with data via Steam
License:        LicenseRef-Proprietary
URL:            https://store.steampowered.com/app/105450/Age_of_Empires_III_2007/
Source0:       build.sh
Source1:       aoe3.conf
Source2:       aoe3.desktop
Source3:       README.md
Source4:       aoe3.png

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  python3
Requires:       gamelaunch
Requires:       hicolor-icon-theme
%ifarch aarch64
Requires:       umu-launcher
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       (umu-launcher or wine)
%endif

%description
Age of Empires III (2007) Complete Collection using Wine with data via Steam

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare
v=$(cat work/meta/version)
[ "$v" = "%{version}" ] || { echo "Steam download is version $v but the spec computed %{version}; fetch it first with tools/fetch-steam" >&2; exit 1; }

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/aoe3.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com>
- Switch to gamelaunch (umu/Proton default, system wine fallback)
