#!/usr/bin/make -f
# Generated by tools/gen.py from package.toml - edit package.toml instead.
include /usr/share/dpkg/architecture.mk
export PT_SRCDIR := $(CURDIR)
export PT_WORK := $(CURDIR)/work

%:
	dh $@

override_dh_auto_build:
	debian/fetch-sources
	bash build.sh prepare

override_dh_auto_install:
	bash build.sh install debian/dirtrally-steam
	bash build.sh deb-split debian/dirtrally-steam debian/dirtrally-steam-data 5

# Prebuilt game files: leave them exactly as shipped.
override_dh_strip override_dh_dwz override_dh_shlibdeps override_dh_makeshlibs override_dh_strip_nondeterminism:

override_dh_builddeb:
	dh_builddeb -- -Zzstd -z1

# x86 runtime on amd64; FEX/box64 emulation on arm64.
ifeq ($(DEB_HOST_ARCH),arm64)
PT_DEPENDS := 
else
PT_DEPENDS := libc6, libasound2t64, libcairo2, libcap2, libcom-err2, libcups2t64, libdbus-1-3, libexpat1, libfontconfig1, libfreetype6, libgcc-s1, libglib2.0-0t64, libgomp1, libgssapi-krb5-2, libk5crypto3, libkrb5-3, libnspr4, libnss3, libpango-1.0-0, libpangocairo-1.0-0, libsdl2-2.0-0, libsdl2-image-2.0-0, libsdl2-ttf-2.0-0, libstdc++6, libvorbis0a, libx11-6, libxcomposite1, libxcursor1, libxdamage1, libxext6, libxfixes3, libxi6, libxrandr2, libxrender1, libxtst6, zlib1g
endif
override_dh_gencontrol:
	dh_gencontrol -- -v$$(cat work/meta/version)-3 '-Vpt:Depends=$(PT_DEPENDS)'

override_dh_auto_clean:
	rm -rf work
