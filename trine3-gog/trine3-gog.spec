# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# x86 game binaries in a noarch package: the same files run on x86_64
# and, through FEX, on aarch64.
%global _binaries_in_noarch_packages_terminate_build 0
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/trine3/.*$
%global __requires_exclude_from ^/opt/trine3/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           trine3-gog
Version:        2.2.0.4
Release:        3%{?dist}
Summary:        Trine 3: The Artifacts of Power (native Linux) with data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/trine_3_the_artifacts_of_power
Source0:       build.sh
Source1:       trine3.conf
Source2:       trine3.desktop
Source3:       README.md
Source4:       gog_trine_3_the_artifacts_of_power_2.2.0.4.sh

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Requires:       gamelaunch
Requires:       hicolor-icon-theme
Requires:       (fex-emu if glibc(aarch-64))
Requires:       (xwininfo if glibc(x86-64))
Requires:       (mesa-libGLU if glibc(x86-64))
Requires:       (libXxf86vm if glibc(x86-64))
Requires:       (openal-soft if glibc(x86-64))
Requires:       (libdrm if glibc(x86-64))
Requires:       (libogg if glibc(x86-64))
Requires:       (libvorbis if glibc(x86-64))
Requires:       (freetype if glibc(x86-64))
Requires:       (libX11 if glibc(x86-64))
# On aarch64: x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     (fex-emu-rootfs-fedora if glibc(aarch-64))
Recommends:     (fex-emu-thunks if glibc(aarch-64))
Recommends:     (muvm if glibc(aarch-64))

%description
Trine 3: The Artifacts of Power (native Linux) with data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/trine3.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 2.2.0.4-3
- Switch to gamelaunch
