# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/unreal\-tournament/.*$
%global __requires_exclude_from ^/opt/unreal\-tournament/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           unreal-tournament-data-archiveorg
Version:        436
Release:        4%{?dist}
Summary:        Unreal Tournament 99 (GOTY) data from the archive.org CD image
License:        LicenseRef-Proprietary
URL:            https://archive.org/details/ut-goty
Source0:       build.sh
Source1:       README.md
Source2:       https://archive.org/download/ut-goty/UT_GOTY_CD1.iso#/UT_GOTY_CD1.iso
Source3:       https://github.com/OldUnreal/UnrealTournamentPatches/releases/download/v469e/OldUnreal-UTPatch469e-Linux-amd64.tar.bz2#/OldUnreal-UTPatch469e-Linux-amd64.tar.bz2
Source4:       https://github.com/OldUnreal/UnrealTournamentPatches/releases/download/v469e/OldUnreal-UTPatch469e-Linux-arm64.tar.bz2#/OldUnreal-UTPatch469e-Linux-arm64.tar.bz2

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  bsdtar
Recommends:     unreal-tournament-bin
Provides:       unreal-tournament-data
Conflicts:      unreal-tournament-data

%description
Game data for Unreal Tournament: Game of the Year Edition, unpacked from the
GOTY CD 1 image on archive.org and installed to /opt/unreal-tournament. Play
it with the native OldUnreal binaries from unreal-tournament-bin.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 436-4
- Generated package (tools/gen.py); builds for Arch, Fedora and Debian
- Decompress the CD's .unr.uz maps at build time with OldUnreal's ucc-bin (the game cannot load them from /opt)
- Drop the files unreal-tournament-bin ships in any letter case, the old Windows ini and localisation files
