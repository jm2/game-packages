# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

# Arch only: RPM and Debian users can install the tributary-*.rpm / *.deb
# assets that upstream publishes with each release.
pkgname=tributary-bin
pkgver=0.7.2
pkgrel=2
pkgdesc="A high-performance, Rhythmbox-style media manager (prebuilt binary)"
arch=('x86_64')
url="https://github.com/jm2/tributary"
license=('GPL-3.0-or-later')
depends=('dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk4>=4.16' 'hicolor-icon-theme' 'libadwaita>=1.6' 'libgcc'
         'pango' 'gstreamer' 'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav')
provides=("tributary=${pkgver}")
conflicts=('tributary')
options=('!strip' '!debug')
# Upstream's own Arch package from the release.
source=("${pkgname}-${pkgver}.pkg.tar.zst::${url}/releases/download/v${pkgver}/tributary-x86_64.pkg.tar.zst")
sha256sums=('4ec5d3a61415967522d83795295d2d2675d389c8b765abbdbb979b2b88d738c0')

package() {
  cp -a --no-preserve=ownership "${srcdir}/usr" "${pkgdir}/"
  mv "${pkgdir}/usr/share/licenses/tributary" "${pkgdir}/usr/share/licenses/${pkgname}"
}
