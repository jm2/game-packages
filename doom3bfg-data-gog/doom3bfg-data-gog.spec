# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/usr/share/games/doom3bfg/.*$
%global __requires_exclude_from ^/usr/share/games/doom3bfg/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           doom3bfg-data-gog
Version:        1
Release:        6%{?dist}
Summary:        Doom 3 BFG Edition data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/doom_3_bfg_edition
Source0:       build.sh
Source1:       README.md
Source2:       setup_doom3_bfg_edition_1.14_20230201_(62122).exe
Source3:       setup_doom3_bfg_edition_1.14_20230201_(62122)-1.bin
Source4:       setup_doom3_bfg_edition_1.14_20230201_(62122)-2.bin

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  innoextract
Provides:       doom3bfg-data
Conflicts:      doom3bfg-data

%description
Doom 3 BFG Edition data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1-6
- Generated from package.toml
- Update to GOG's 1.14 20230201 installer (build 62122)
- Conflict with the virtual doom3bfg-data instead of naming the other source packages, like every Doom 3 BFG data package (Windows lists the providers by name)
- Rebuilt without set-group-ID bits on its directories, which made RPM refuse to install it beside its engine package
