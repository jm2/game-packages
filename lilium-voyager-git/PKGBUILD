pkgname=lilium-voyager-git
pkgver=20261031.g51fccb9b
pkgrel=1
pkgdesc="An ioquake3-based Voyager: Elite Force source port"
url="https://clover.moe/lilium-voyager/"
license=('GPL-2.0-or-later')
arch=('x86_64' 'aarch64')
depends=('curl' 'freetype2' 'glibc' 'hicolor-icon-theme' 'libjpeg-turbo' 'libmad' 'libvorbis'
         'openal' 'opus' 'opusfile' 'sdl2' 'zlib')
makedepends=('git')
optdepends=('mumble: Mumble positional audio'
            'eliteforce-data: retail Elite Force data in /opt/lilium-voyager/baseEF')
conflicts=('lilium-voyager' 'lilium-voyager-bin')
provides=('lilium-voyager')
source=('lilium-voyager::git+https://github.com/zturtleman/lilium-voyager.git'
        'q3make.sh'
        'lilium-voyager.desktop'
        'lilium-voyager-server.service'
        'README.md')
sha256sums=('SKIP'
            '18f2ac18111c0bc67397cf17deaea8951de1fc47f3ef21e7cfc767d0342e300c'
            '8b308ed30016c57fb44224f0d263e179393324ecd6778765996667999247751a'
            '454ac11caf594ed9b65def1daaef4ae6e8699411461078ad338b72c3ac83788c'
            '21479c9579c6e81f06e09d8a1ade106561a8ea9aa97da65fd1db0b4c6d54cb1c')

pkgver() {
    cd "${srcdir}/lilium-voyager"
    git log -1 --format="%cd.g%h" --date=short | sed 's/-//g'
}

build() {
    sh "${srcdir}/q3make.sh" build "${srcdir}/lilium-voyager"
}

package() {
    sh "${srcdir}/q3make.sh" install "${srcdir}/lilium-voyager" "${pkgdir}" "${pkgname}"
}
