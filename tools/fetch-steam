#!/usr/bin/env python3
"""Download a package's Steam data into the build cache with steamcmd.

    tools/fetch-steam <package> [--user NAME]

Writes ${PT_CACHE:-${TMPDIR:-/var/tmp}/linux-packages-cache}/<package>/steam-<appid>/,
which build.sh uses instead of running steamcmd itself, so the actual
makepkg/rpmbuild/dpkg-buildpackage run is non-interactive and offline.
steamcmd asks for the password and Steam Guard code; STEAM_USER or --user
gives the account name. Only one fetch runs at a time, as the account allows
just one Steam session: a second one waits for the first.
"""
import fcntl, os, re, shutil, subprocess, sys, tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

def CONTENT_BASES(dest: Path, home: Path) -> tuple[Path, ...]:
    """Where steamcmd puts download_depot results."""
    return (dest / "steamapps/content", home / ".steam/steamcmd/linux32/steamapps/content",
            home / ".local/share/Steam/steamcmd/linux32/steamapps/content",
            home / ".local/share/steamcmd/linux32/steamapps/content",
            home / ".steam/steam/steamapps/content", home / "Steam/steamapps/content")


def depot_dirs(app, depot, dest: Path, log: str, home: Path) -> list[Path]:
    """Every directory that may hold depot <depot> of <app> after steamcmd ran.

    With +@sSteamCmdForcePlatformType windows, steamcmd on Linux can report
    (and write to) a Windows-style path such as
    ~/.steam/steamcmd/linux32\\steamapps\\content\\app_2350\\depot_2351: one
    directory whose name holds the backslashes, next to a forward-slash tree
    that may only have the depot's empty directories."""
    tail = f"app_{app}/depot_{depot}"
    found = []
    for m in re.finditer(r'Depot download complete : "([^"]+)"', log):
        if m.group(1).replace("\\", "/").endswith(tail):
            found += [Path(m.group(1)), Path(m.group(1).replace("\\", "/"))]
    for base in CONTENT_BASES(dest, home):
        found.append(base / tail)
        # The backslash form of the same path, as one name in the parent.
        parts = base.parts
        for i in range(len(parts) - 1, 0, -1):
            found.append(Path(*parts[:i]) / "\\".join(parts[i:] + (f"app_{app}", f"depot_{depot}")))
    out = []
    for d in found:
        if d.is_dir() and d.resolve() not in [o.resolve() for o in out]:
            out.append(d)
    return out


def clear_depot_state(app, depot, dest: Path, home: Path) -> None:
    """Forget an earlier download of the depot before fetching it again.

    steamcmd keeps app_<app>/state_<app>_<depot>.patch next to the depot and
    patches against the files it expects to find; with the depot gone (moved
    into a cache, then deleted), it "completes" without writing a file."""
    for d in depot_dirs(app, depot, dest, "", home):
        shutil.rmtree(d)
    for base in CONTENT_BASES(dest, home):
        state = base / f"app_{app}" / f"state_{app}_{depot}.patch"
        if state.is_file():
            print(f"fetch-steam: removing stale {state}", flush=True)
            state.unlink()


def collect_depot(app, depot, dest: Path, log: str, home: Path | None = None) -> bool:
    """Merge the depot into dest from wherever steamcmd put it, then delete
    those copies (they may be under the home directory, which can be on a much
    smaller disk than the cache). False if no file arrived."""
    home = home or Path.home()
    files = 0
    for src in depot_dirs(app, depot, dest, log, home):
        files += sum(1 for p in src.rglob("*") if p.is_file())
        subprocess.run(["cp", "-rn", f"{src}/.", f"{dest}/"], check=True)
        shutil.rmtree(src)
    return files > 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    pkg = args[0].rstrip("/").split("/")[-1]
    user = os.environ.get("STEAM_USER", "")
    if "--user" in args:
        user = args[args.index("--user") + 1]
    toml = REPO / pkg / "package.toml"
    if not toml.exists():
        sys.exit(f"fetch-steam: {pkg} has no package.toml")
    t = tomllib.loads(toml.read_text())
    steam = t.get("source", {}).get("steam")
    if not steam:
        sys.exit(f"fetch-steam: {pkg} does not use Steam data")
    if not shutil.which("steamcmd"):
        sys.exit("fetch-steam: steamcmd is not installed")
    if not user:
        user = input("Steam username: ").strip()
    cache = Path(os.environ.get("PT_CACHE") or Path(os.environ.get("TMPDIR", "/var/tmp")) / "linux-packages-cache")
    appid = steam["appid"]
    wine = t["family"].startswith("wine") or t["family"] == "data-steam"
    platform = steam.get("platform", "windows" if wine else "linux")
    dest = cache / pkg / f"steam-{appid}"
    dest.mkdir(parents=True, exist_ok=True)
    cmd = ["steamcmd", "+@sSteamCmdForcePlatformType", platform, "+@ShutdownOnFailedCommand", "1",
           "+force_install_dir", str(dest), "+login", user, f"+app_update {appid} validate"]
    depots = steam.get("depots", [])
    for app, depot in depots:
        cmd.append(f"+download_depot {app} {depot}")
    cmd.append("+quit")
    print("fetch-steam:", " ".join(cmd[:-1]), flush=True)
    # Under the home directory, not the cache: the limit is per account, and
    # fetches can use different caches.
    lock = (Path.home() / ".fetch-steam.lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    for app, depot in depots:
        clear_depot_state(app, depot, dest, Path.home())
    # Keep steamcmd's output (still shown live): it names where each depot went.
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    log = []
    for line in proc.stdout:
        sys.stdout.write(line); sys.stdout.flush()
        log.append(line)
    if proc.wait():
        sys.exit(f"fetch-steam: steamcmd exited with {proc.returncode}")
    for app, depot in depots:
        if not collect_depot(app, depot, dest, "".join(log)):
            sys.exit(f"fetch-steam: depot {depot} of app {app} has no files after the download")
    print(f"fetch-steam: {pkg} cached in {dest}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
