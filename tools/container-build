#!/bin/bash
# Build one package directory in a clean container for each format.
#
#   tools/container-build <pkgdir> [arch|fedora|debian|all] [extra deps...]
#
# Uses podman with archlinux:latest, fedora:45 (FEDORA_RELEASE overrides it)
# and debian:sid. The package directory is copied into a scratch dir under
# ${TMPDIR:-/var/tmp}, and each build runs in a mounted directory there, not in
# the container's own layer, so point TMPDIR at a disk with room for the
# game: a build needs about twice its installed size. Results (packages +
# logs) are written to ${OUT:-${TMPDIR:-/var/tmp}/linux-packages-out}/<pkg>/<distro>/.
#
# Only for packages whose sources can be fetched non-interactively. Game
# packages that need Steam/GOG data must be given a pre-filled cache via
# PT_CACHE (see tools/fetch-steam, tools/fetch-gog).
set -euo pipefail

pkgdir=$(realpath "${1:?usage: container-build <pkgdir> [arch|fedora|debian|all] [deps...]}")
which=${2:-all}; shift $(( $# >= 2 ? 2 : 1 ))
extra=("$@")
pkg=$(basename "$pkgdir")
out=${OUT:-${TMPDIR:-/var/tmp}/linux-packages-out}/$pkg
work=$(mktemp -d -p "${TMPDIR:-/var/tmp}" "cb-$pkg.XXXXXX")
# Builds leave files owned by the container's unprivileged user, which only
# the user namespace can delete.
wipe() {
    rm -rf "$1" 2>/dev/null || podman unshare rm -rf "$1" ||
        echo "container-build: couldn't remove $1" >&2
}
trap 'wipe "$work"' EXIT
cp -a "$pkgdir" "$work/$pkg"
# Store downloads (GOG/Humble installers) cached by tools/fetch-* go next to
# the build files in the scratch copy, where makepkg/rpmbuild/dpkg expect them.
if [ -n "${PT_CACHE:-}" ] && [ -d "$PT_CACHE/$pkg" ]; then
    # Hardlinked if possible: a GOG installer can be tens of GB.
    find "$PT_CACHE/$pkg" -maxdepth 1 -type f -exec sh -c \
        'cp -ln "$1" "$2/" 2>/dev/null || cp -n "$1" "$2/"' _ {} "$work/$pkg" \;
fi
mkdir -p "$out"
local_root=${OUT:-${TMPDIR:-/var/tmp}/linux-packages-out}
cache_mount=(-v "$local_root:/local:ro,z" -e LOCAL="${LOCAL:-}" -e NODEPS="${NODEPS:-}")
[ -n "${PT_CACHE:-}" ] && cache_mount+=(-v "$PT_CACHE:/cache:ro,z" -e PT_CACHE=/cache)

run() { # distro image script
    local d=$1 img=$2 script=$3
    mkdir -p "$out/$d" "$work/build-$d"
    echo "==> $pkg: $d ($img)"
    if podman run --rm -v "$work/$pkg:/src:ro,Z" -v "$out/$d:/out:Z" -v "$work/build-$d:/build:Z" "${cache_mount[@]}" \
        -e EXTRA="${extra[*]}" "$img" bash -euo pipefail -c "$script" > "$out/$d/build.log" 2>&1; then
        echo "    ok: $(cd "$out/$d" && ls -- *.pkg.tar* *.rpm *.deb 2>/dev/null | tr '\n' ' ')"
    else
        echo "    FAILED, see $out/$d/build.log"; tail -n 25 "$out/$d/build.log" | sed 's/^/    | /'
        wipe "$work/build-$d"
        return 1
    fi
    wipe "$work/build-$d"
}

rc=0
if [[ $which == arch || $which == all ]] && [ -f "$pkgdir/PKGBUILD" ]; then
run arch docker.io/library/archlinux:latest '
mkdir -m 1777 /build/tmp; export TMPDIR=/build/tmp  # rpmlint and namcap unpack packages here
printf "[multilib]\nInclude = /etc/pacman.d/mirrorlist\n" >> /etc/pacman.conf
pacman -Syu --noconfirm --needed base-devel git namcap $EXTRA >/dev/null
for l in $LOCAL; do pacman -U --noconfirm /local/$l/arch/*.pkg.tar.zst >/dev/null; done
useradd -m b; cp -a /src /build/p; chown -R b /build; chmod 755 /build
cd /build/p
su b -c "makepkg --printsrcinfo" > /tmp/srcinfo
# makepkg -s would need sudo; install the repo-available deps as root instead.
deps=$(sed -n -E "s/^\s*(check|make)?depends(_x86_64)? = ([^<>=]+).*/\3/p" /tmp/srcinfo | sort -u)
avail=$(for d in $deps; do pacman -Sp "$d" >/dev/null 2>&1 && echo "$d"; done; true)  # -Sp also resolves provides (java-runtime-headless)
[ -z "$avail" ] || pacman -S --noconfirm --needed $avail >/dev/null
# The checksums pin every source; these containers have no PGP keyring.
su b -c "makepkg --verifysource --skippgpcheck --noconfirm" || { echo "ERROR: source checksum verification failed"; exit 1; }
# PKGDEST keeps built packages apart from sources or stale files named *.pkg.tar.zst.
mkdir /build/pkgs; chown b /build/pkgs
if [ -n "$NODEPS" ]; then su b -c "PKGDEST=/build/pkgs makepkg -d --skippgpcheck --noconfirm 2>&1" || exit 1
else su b -c "PKGDEST=/build/pkgs makepkg -s --skippgpcheck --noconfirm 2>&1" || exit 1; fi
namcap PKGBUILD /build/pkgs/*.pkg.tar.zst || true
cp /build/pkgs/*.pkg.tar.zst /out/' || rc=1
fi

if [[ $which == fedora || $which == all ]] && compgen -G "$pkgdir/*.spec" >/dev/null; then
run fedora "registry.fedoraproject.org/fedora:${FEDORA_RELEASE:-45}" '
mkdir -m 1777 /build/tmp; export TMPDIR=/build/tmp
dnf -yq install rpm-build rpmdevtools rpmlint dnf-plugins-core $EXTRA >/dev/null
for l in $LOCAL; do dnf -yq install /local/$l/fedora/*.rpm >/dev/null; done
mkdir -p /build/SOURCES; cp -a /src/. /build/SOURCES/; cd /build/SOURCES
spec=$(ls *.spec)
spectool -g -C /build/SOURCES "$spec" >/dev/null || true
dnf -yq builddep "$spec" >/dev/null
rpmbuild -bb --define "_topdir /build" --define "_sourcedir /build/SOURCES" --define "_tmppath /build/tmp" "$spec"
# rpmlint holds the payload in memory; on the 100 GB Steam data packages that
# exhausts RAM and takes the build down with it. Lint the spec and every RPM
# up to 2 GiB, and only name the larger ones.
small=()
for r in /build/RPMS/*/*.rpm; do
    if [ "$(stat -c %s "$r")" -le $((2 << 30)) ]; then small+=("$r")
    else echo "rpmlint: skipping ${r##*/} ($(du -h "$r" | cut -f1)), over 2 GiB"; fi
done
rpmlint "$spec" "${small[@]}" || true
cp /build/RPMS/*/*.rpm /out/' || rc=1
fi

if [[ $which == debian || $which == all ]] && [ -d "$pkgdir/debian" ]; then
run debian docker.io/library/debian:sid '
export DEBIAN_FRONTEND=noninteractive
apt-get -qq update; apt-get -qq install -y --no-install-recommends build-essential devscripts equivs lintian fakeroot $EXTRA >/dev/null
for l in $LOCAL; do apt-get -qq install -y /local/$l/debian/*.deb >/dev/null; done
cp -a /src /build/p; cd /build/p
mk-build-deps -i -r -t "apt-get -y -qq --no-install-recommends" debian/control >/dev/null
# After mk-build-deps, which loses its output with TMPDIR set.
mkdir -m 1777 /build/tmp; export TMPDIR=/build/tmp
[ -x debian/fetch-sources ] && debian/fetch-sources
dpkg-buildpackage -b -us -uc
lintian --suppress-tags bad-distribution-in-changes-file ../*.deb || true
cp ../*.deb /out/' || rc=1
fi
exit $rc
