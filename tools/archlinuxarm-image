#!/bin/bash
# Build the localhost/archlinuxarm image that tools/container-build uses for
# Arch aarch64 builds (Arch Linux ARM publishes no container image).
#
#   tools/archlinuxarm-image
#
# Downloads the official aarch64 rootfs tarball, checks its signature against
# the Arch Linux ARM Build System key, and imports it as an arm64 image. On an
# x86_64 host, running it needs qemu-user-static-aarch64 (binfmt).
set -euo pipefail
url=http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz
# Arch Linux ARM Build System <builder@archlinuxarm.org>
key=68B3537F39A313B3E574D06777193F152BDBE6A6
work=$(mktemp -d -p "${TMPDIR:-/var/tmp}" alarm.XXXXXX)
trap 'GNUPGHOME=$work/gnupg gpgconf --kill all 2>/dev/null; rm -rf "$work"' EXIT
cd "$work"
echo "==> downloading ${url##*/}"
curl -fL --retry 3 -A 'Mozilla/5.0' -o rootfs.tar.gz "$url"
curl -fsL --retry 3 -A 'Mozilla/5.0' -o rootfs.tar.gz.sig "$url.sig"
export GNUPGHOME=$work/gnupg
mkdir -m 700 "$GNUPGHOME"
gpg -q --keyserver hkps://keyserver.ubuntu.com --recv-keys "$key"
gpg -q --status-fd 1 --verify rootfs.tar.gz.sig rootfs.tar.gz | grep -q "VALIDSIG $key " ||
    { echo "archlinuxarm-image: bad signature" >&2; exit 1; }
echo "==> signature ok ($key)"
podman import --arch arm64 --change 'CMD ["/bin/bash"]' rootfs.tar.gz localhost/archlinuxarm:latest >/dev/null
echo "==> localhost/archlinuxarm:latest"
