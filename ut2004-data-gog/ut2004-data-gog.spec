# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/ut2004/.*$
%global __requires_exclude_from ^/opt/ut2004/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           ut2004-data-gog
Version:        3369
Release:        3%{?dist}
Summary:        Unreal Tournament 2004 ECE data from GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/unreal_tournament_2004_ece
Source0:       build.sh
Source1:       README.md
Source2:       setup_unreal_tournament_2004_1.0_(18947).exe
Source3:       setup_unreal_tournament_2004_1.0_(18947)-1.bin

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  innoextract
Recommends:     ut2004-bin
Provides:       ut2004-data
Conflicts:      ut2004-data
Conflicts:      ut2004-gog

%description
Game data for Unreal Tournament 2004: Editor's Choice Edition, extracted from
the GOG installer you download yourself and installed to /opt/ut2004. Play it
with the native OldUnreal binaries from ut2004-bin.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

