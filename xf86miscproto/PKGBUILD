# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>
# Contributor: alucryd <alucryd at gmail dot com>

pkgname=xf86miscproto
pkgver=0.9.3
pkgrel=2
pkgdesc="X11 Misc extension wire protocol"
arch=('any')
url="https://gitlab.freedesktop.org/xorg/proto/xf86miscproto"
license=('X11')
source=("https://www.x.org/releases/individual/proto/${pkgname}-${pkgver}.tar.bz2")
sha256sums=('45b8ec6a4a8ca21066dce117e09dcc88539862e616e60fb391de05b36f63b095')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
