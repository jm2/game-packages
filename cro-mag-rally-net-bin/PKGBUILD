# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>
# Contributor: George Rawlinson <george@rawlinson.net.nz>

pkgname=cro-mag-rally-net-bin
_pkgname=cro-mag-rally
_upname=CroMagRally
pkgver=3.2.0
pkgrel=1
pkgdesc='The wildest racing game since man invented the wheel! LAN multiplayer build (prebuilt binary).'
arch=('x86_64' 'aarch64')
url='https://github.com/jm2/CroMagRally'
# Game (CC-BY-NC-SA-4.0) and the bundled SDL3, Pomme and support code; see
# THIRD-PARTY-LICENSES.md.
license=('CC-BY-NC-SA-4.0' 'Zlib' 'MIT' 'LGPL-2.1-or-later' 'BSD-3-Clause' 'BSL-1.0' 'CC0-1.0'
         'Apache-2.0' 'SunPro')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd' 'libstdc++' 'sh')
# The bundled SDL3 dlopen()s its video and audio backends.
optdepends=('libx11: X11 video (with libxcursor, libxext, libxfixes, libxi, libxrandr)'
            'libxcursor: X11 video'
            'libxext: X11 video'
            'libxfixes: X11 video'
            'libxi: X11 video'
            'libxrandr: X11 video'
            'wayland: native Wayland video'
            'libxkbcommon: native Wayland keyboard input'
            'libdecor: Wayland window decorations'
            'libpulse: PulseAudio/PipeWire audio output'
            'alsa-lib: ALSA audio output')
provides=("${pkgname%-bin}=${pkgver}" "${_pkgname}=${pkgver}")
conflicts=("${pkgname%-bin}" "${_pkgname}")
replaces=("${pkgname%-bin}")
options=('!strip' '!debug')
# Upstream's release packages: its Arch package on x86_64; it publishes none
# for aarch64, so Arch Linux ARM gets the files from its aarch64 .deb.
source=('install.sh'
        'README.md')
source_x86_64=("${url}/releases/download/v${pkgver}/${_upname}-${pkgver}-linux-x86_64.pkg.tar.zst")
source_aarch64=("${url}/releases/download/v${pkgver}/${_upname}-${pkgver}-linux-aarch64.deb")
noextract=("${_upname}-${pkgver}-linux-x86_64.pkg.tar.zst" "${_upname}-${pkgver}-linux-aarch64.deb")
sha256sums=('93771dac042de77e0903dffb56d4b612ee6616723519ba3a628a4b4bbe3e79cb'
            '6b12e24691258c71f03aef49566852f75f8f90fd66893dbcc40f63d8b975f377')
sha256sums_x86_64=('b251d66e1ae78a295d6ebd5d303a32829380ad36633d05b6d82e59a9b15f3f2e')
sha256sums_aarch64=('bc18aefea7221221174668cc661978c9d52e1bbc185b9edacd55519473f48abc')

prepare() {
  rm -rf root && mkdir root
  case "${CARCH}" in
    x86_64)  bsdtar -xf "${_upname}-${pkgver}-linux-x86_64.pkg.tar.zst" -C root usr ;;
    aarch64) bsdtar -xOf "${_upname}-${pkgver}-linux-aarch64.deb" 'data.tar.*' | bsdtar -xf - -C root ;;
  esac
}

package() {
  sh install.sh "${srcdir}/root" "${pkgdir}" "/usr/share/doc/${pkgname}" "/usr/share/licenses/${pkgname}"
}
