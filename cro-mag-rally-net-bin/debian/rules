#!/usr/bin/make -f
# Mirrors the PKGBUILD and cro-mag-rally-net-bin.spec: keep the three in step.
DEB_HOST_GNU_CPU ?= $(shell dpkg-architecture -qDEB_HOST_GNU_CPU)
VER := 3.2.0
D := $(CURDIR)/debian/cro-mag-rally-net-bin
DOC := /usr/share/doc/cro-mag-rally-net-bin

%:
	dh $@

override_dh_auto_build:
	debian/fetch-sources
	# Upstream's release .deb for the host architecture (x86_64 or aarch64).
	rm -rf root && dpkg-deb -x CroMagRally-$(VER)-linux-$(DEB_HOST_GNU_CPU).deb root

override_dh_auto_install:
	sh install.sh root $(D) $(DOC) $(DOC)
	desktop-file-validate $(D)/usr/share/applications/io.jor.cromagrally.desktop

override_dh_auto_test:

# Prebuilt binaries: keep them as upstream shipped them.
override_dh_strip override_dh_dwz override_dh_shlibdeps override_dh_makeshlibs override_dh_strip_nondeterminism:

override_dh_auto_clean:
	rm -rf root
