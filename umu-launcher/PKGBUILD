# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>
# Based on the AUR umu-launcher PKGBUILD (loathingkernel), updated to 1.4.x:
# system pyzstd/urllib3, the Rust delta-update module, and aarch64.

pkgname=umu-launcher
pkgver=1.4.4
pkgrel=1
pkgdesc="Unified Launcher for Windows games on Linux: runs Proton with its fixes outside of Steam"
arch=('x86_64' 'aarch64')
url="https://github.com/Open-Wine-Components/umu-launcher"
license=('GPL-3.0-only')
depends=(
  # Steam Linux Runtime host requirements (from the AUR package)
  bash desktop-file-utils diffutils hicolor-icon-theme curl dbus freetype2
  gdk-pixbuf2 ttf-font zenity lsb-release nss usbutils xorg-xrandr
  vulkan-driver vulkan-icd-loader lsof xdg-user-dirs glibc libxcrypt
  libxcrypt-compat gcc-libs
  # umu
  python python-xlib python-urllib3
)
depends_x86_64=(
  lib32-glibc lib32-libxcrypt lib32-libxcrypt-compat lib32-libgl lib32-gcc-libs
  lib32-libx11 lib32-libxss lib32-alsa-plugins lib32-libgpg-error lib32-nss
  lib32-vulkan-driver lib32-vulkan-icd-loader
)
optdepends=('python-truststore: use the system CA store for downloads'
            'python-pyzstd: delta updates of Proton and the runtime'
            'python-xxhash: delta updates of Proton and the runtime'
            'python-cbor2: delta updates of Proton and the runtime')
makedepends=('cargo' 'scdoc' 'python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('19767e226b0b937b1dcdcd00282eb31d1a7bb42ee01d54f6dae78e44ab8e3284')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure.sh --prefix=/usr --use-system-pyzstd --use-system-urllib
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
