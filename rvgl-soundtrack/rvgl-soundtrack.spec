# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/rvgl/packs/soundtrack/.*$
%global __requires_exclude_from ^/opt/rvgl/packs/soundtrack/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           rvgl-soundtrack
Version:        20.1008
Release:        1%{?dist}
Summary:        Original Re-Volt soundtrack for RVGL
License:        LicenseRef-Proprietary
URL:            https://rvgl.org
Source0:       build.sh
Source1:       README.md
Source2:       https://distribute.re-volt.io/packs/soundtrack.zip#/soundtrack-20.1008.zip

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Recommends:     rvgl-bin

%description
The original Re-Volt soundtrack (based on the Dreamcast version) as Ogg
Vorbis files, installed as RVGL's soundtrack pack in
/opt/rvgl/packs/soundtrack and downloaded at build time from Re-Volt I/O.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 20.1008-1
- Initial package: soundtrack 20.1008
