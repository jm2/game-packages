# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=agelanserver-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Age Server (formerly ageLANServer): LAN server and launcher for Age of Empires II/III: DE and Age of Mythology: Retold"
arch=('x86_64' 'aarch64')
url="https://github.com/luskaner/ageServer"
license=('AGPL-3.0-only')
depends=('gamelaunch')
optdepends=('agelanserver-companion-bin: game-side DLLs (pulled in by the game packages)')
provides=("agelanserver=${pkgver}")
conflicts=('agelanserver')
backup=('etc/agelanserver/config.toml')
options=('!strip' '!debug')
source=("agelan" "client" "agelanserver@.service" "install.sh" "README.md")
source_x86_64=("ageServer_full_${pkgver}_linux_x86-64.tar.gz::${url}/releases/download/v${pkgver}/ageServer_full_${pkgver}_linux_x86-64.tar.gz")
source_aarch64=("ageServer_full_${pkgver}_linux_arm64.tar.gz::${url}/releases/download/v${pkgver}/ageServer_full_${pkgver}_linux_arm64.tar.gz")
noextract=("ageServer_full_${pkgver}_linux_x86-64.tar.gz" "ageServer_full_${pkgver}_linux_arm64.tar.gz")
sha256sums=('1bd18ce9d1f3757951f9f3c1f0ef263e7585b0ff5e7533c0ba1c84fa68b25a62'
            '53e8a259ba36643677214efe51d40968f473f0d6611c680a175d606674a006d4'
            'fb8340537f8c2364d9d426321f8caf3837eda7f3aeb7713b150cb8e068feedf4'
            'd0274a9e051e5ad9d11852e5f91d2c7922ea5a7c4c32b6d21ad735fcadc3bbae'
            '9297d36e9c53b6e94d926edbeaf6261222ab35e21bec8c7f2a5ee2325886f236')
sha256sums_x86_64=('7dfa0407465b78b77da45b9b88819098127201579cfec84a47f8fdb171d2a0c7')
sha256sums_aarch64=('9de5d0838c952f5e6df1ecf105a6f95df460d5bc3f425cc9ed7febff6538ed7b')

prepare() {
    local _a=x86-64
    [ "${CARCH}" = aarch64 ] && _a=arm64
    rm -rf upstream && mkdir upstream
    bsdtar -xf "ageServer_full_${pkgver}_linux_${_a}.tar.gz" -C upstream
}

package() {
    sh install.sh "${srcdir}/upstream" "${pkgdir}"
    install -Dm644 upstream/docs/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
