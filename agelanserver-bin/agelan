#!/bin/sh
# agelan - run luskaner's Age Server (formerly ageLANServer) launcher for a
# game package.
#
#   agelan <gamelaunch id> [launcher options]     e.g. agelan aoe2-de
#   agelan --list                                 games with LAN support
#
# Game packages describe themselves in /usr/share/agelanserver/games/<id>.conf.
# The launcher and the companion DLLs run from the
# read-only install in /usr/lib; its configs are generated for every run
# (from /usr/share/agelanserver/templates) into a private runtime directory,
# so they never go stale after a package update. Copy a template to
# ~/.config/agelanserver/ to override it (same @PLACEHOLDERS@ apply).
#
# The game is started through gamelaunch (umu/Proton or system wine) with the
# companion DLLs' --overrideHosts/--overrideCerts, so neither /etc/hosts nor
# the system trust store is touched and no root is needed to join.
#
# Hosting: if no server is found on the LAN, the launcher offers to start one.
# That server runs from a per-user copy in ~/.local/share/agelanserver/server
# (it keeps certificates, user data and replays next to its own binary), runs
# its own embedded Battle Server, and needs permission to listen on port 443;
# for a machine that hosts regularly, use the system service instead:
# systemctl enable --now agelanserver@<game>.service
set -eu

LIB=${AGELAN_LIB:-/usr/lib/agelanserver}
SHARE=${AGELAN_SHARE:-/usr/share/agelanserver}
data=${XDG_DATA_HOME:-$HOME/.local/share}
conf=${XDG_CONFIG_HOME:-$HOME/.config}/agelanserver

die() { echo "agelan: $*" >&2; exit 1; }

if [ "${1:-}" = --list ] || [ $# -eq 0 ]; then
    [ $# -eq 0 ] && echo "usage: agelan <game> [launcher options]; games:" >&2
    for f in "$SHARE"/games/*.conf; do
        [ -e "$f" ] || continue
        n=${f##*/}; echo "  ${n%.conf}"
    done
    exit 0
fi
id=$1; shift
gconf=$SHARE/games/$id.conf
[ -f "$gconf" ] || die "no LAN configuration for '$id' (is its game package installed?)"
# Provides: AGELAN_GAME (age2/age3/athens), GAME_DIR, CACERT (relative).
# BATTLESERVER and BATTLESERVER_GAMELAUNCH_ID, from before the server had an
# embedded Battle Server, are no longer used.
. "$gconf"
: "${AGELAN_GAME:?}" "${GAME_DIR:?}" "${CACERT:?}"

gameov=$data/gamelaunch/$id/game

# The launcher writes the server's CA into the game's cacert.pem: the game's
# per-user directory must hold a real copy of it (gamelaunch WRITABLE_COPY).
if [ ! -f "$gameov/$CACERT" ] || [ -L "$gameov/$CACERT" ]; then
    gamelaunch --reset-overlay "$id" >/dev/null || die "could not prepare $gameov"
fi

# Per-user server copy, only used when this user hosts. The server finds its
# resources relative to its real executable and writes certificates, user data
# and replays (responses/cloud/<game>/replays) there, so the binaries are real
# copies (refreshed when the package changes them), those directories are real,
# and everything else is a link to the read-only install.
srv=$data/agelanserver/server
link() { # <target> <link>: (re)place <link> with a symlink to <target>
    [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ] && return
    rm -rf "$2"; ln -s "$1" "$2"
}
sync_server() {
    # agelanserver-bin 1.x (ageLANServer) user data: Age Server 2.0 asks for a
    # fresh userData, so keep the old one aside instead of reusing it.
    if [ -d "$srv/resources/userData" ] && [ ! -e "$srv/.age-server-2" ]; then
        mv "$srv/resources/userData" "$srv/resources/userData.ageLANServer-1.x"
    fi
    # 1.x linked all of responses/; it is a real directory now.
    [ -L "$srv/resources/responses" ] && rm -f "$srv/resources/responses"
    mkdir -p "$srv/resources/certificates" "$srv/resources/userData" "$srv/bin"
    touch "$srv/.age-server-2"
    for d in "$LIB"/server/resources/*; do
        n=${d##*/}
        case $n in certificates|userData|responses) continue ;; esac
        link "$d" "$srv/resources/$n"
    done
    r=$LIB/server/resources/responses
    mkdir -p "$srv/resources/responses/cloud"
    for d in "$r"/*; do
        n=${d##*/}
        [ "$n" = cloud ] || link "$d" "$srv/resources/responses/$n"
    done
    for g in "$r"/cloud/*/; do
        g=${g%/}; n=${g##*/}
        mkdir -p "$srv/resources/responses/cloud/$n/replays"
        for d in "$g"/*; do
            [ "${d##*/}" = replays ] || link "$d" "$srv/resources/responses/cloud/$n/${d##*/}"
        done
    done
    for b in server bin/genCert; do
        if ! cmp -s "$LIB/server/$b" "$srv/$b"; then
            rm -f "$srv/$b"; cp "$LIB/server/$b" "$srv/$b"; chmod 755 "$srv/$b"
        fi
    done
}
# One agelan at a time: the 1.x migration (the marker check, mv and mkdir)
# must not interleave with another run's.
mkdir -p "$srv"
exec 9>"$srv/.lock"
flock 9 || die "could not lock $srv"
sync_server
exec 9>&-

run=$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/agelan.XXXXXX")
trap 'rm -rf "$run"' EXIT INT TERM

render() { # <template name> <output>
    t=$conf/$1
    [ -f "$t" ] || t=$SHARE/templates/$1
    sed -e "s|@GAME@|$AGELAN_GAME|g" \
        -e "s|@GAMELAUNCH_ID@|$id|g" \
        -e "s|@GAME_PATH@|$gameov|g" \
        -e "s|@SERVER@|$srv/server|g" \
        -e "s|@LIB@|$LIB|g" "$t" > "$2"
    # A placeholder left over means an override from an older template
    # (1.x's @BATTLESERVER@ and @BSM_CONFIG@ are gone): don't pass it on.
    p=$(grep -oE '@[A-Z][A-Z_]*@' "$2" | sort -u | tr '\n' ' ')
    [ -z "$p" ] || die "$t uses placeholders agelan no longer fills (${p% }); copy $SHARE/templates/$1 again and redo your changes"
}
render launcher.toml "$run/launcher.toml"
render launcher.game.toml "$run/launcher.game.toml"

"$LIB/launcher/launcher" -e "$AGELAN_GAME" \
    --config "$run/launcher.toml" --gameConfig "$run/launcher.game.toml" "$@"
