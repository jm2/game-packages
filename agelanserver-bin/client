#!/bin/sh
# Client.Executable for ageLANServer's launcher (set by agelan's templates):
# start the game through gamelaunch (umu/Proton or system wine, the game's own
# prefix and per-user directory).
#
#   client <gamelaunch id> [game arguments]
#
# The launcher runs this in a terminal emulator, so it must not rely on the
# environment agelan set up. --option=/unix/path arguments (the launcher's
# {HostFilePath} and {CertFilePath}) become Wine paths (Z:\unix\path) so the
# companion DLLs inside the game can open them.
set -eu
id=${1:?usage: client <gamelaunch id> [game arguments]}
shift
shim=/usr/lib/agelanserver/libexec/shim
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$shim" | paste -sd: -)
export PATH
for a; do
    case $a in
        --*=/*) a="${a%%=*}=Z:$(printf '%s' "${a#*=}" | tr / '\\')" ;;
    esac
    set -- "$@" "$a"
    shift
done
exec gamelaunch "$id" "$@"
