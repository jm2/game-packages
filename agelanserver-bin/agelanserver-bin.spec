# Prebuilt upstream Go binaries.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none

%ifarch aarch64
%global upstream_arch arm64
%else
%global upstream_arch x86-64
%endif

Name:           agelanserver-bin
Version:        1.15.6
Release:        1%{?dist}
Summary:        LAN server and launcher for Age of Empires II/III: DE and Age of Mythology: Retold
License:        AGPL-3.0-only
URL:            https://github.com/luskaner/ageServer
Source0:        %{url}/releases/download/v%{version}/ageLANServer_full_%{version}_linux_x86-64.tar.gz
Source1:        %{url}/releases/download/v%{version}/ageLANServer_full_%{version}_linux_arm64.tar.gz
Source2:        agelan
Source3:        client
Source4:        wine-shim
Source5:        agelanserver@.service
Source6:        install.sh
Source7:        README.md

ExclusiveArch:  x86_64 aarch64
BuildRequires:  systemd-rpm-macros
Requires:       gamelaunch
Recommends:     agelanserver-companion-bin
Provides:       agelanserver = %{version}-%{release}
%{?systemd_requires}

%description
luskaner's ageLANServer: a LAN replacement for the online services of Age of
Empires II/III: Definitive Edition and Age of Mythology: Retold. The launcher
runs from the read-only install with per-run configs generated by `agelan`;
an optional agelanserver@<game>.service hosts a server without root.

%prep
%setup -q -c -T
mkdir upstream
%ifarch aarch64
tar -xf %{SOURCE1} -C upstream
%else
tar -xf %{SOURCE0} -C upstream
%endif
cp -p %{SOURCE2} %{SOURCE3} %{SOURCE4} %{SOURCE5} %{SOURCE6} %{SOURCE7} .
cp -p upstream/docs/LICENSE .

%build

%install
sh install.sh upstream %{buildroot}

%post
%systemd_post agelanserver@.service

%preun
%systemd_preun 'agelanserver@*.service'

%postun
%systemd_postun_with_restart 'agelanserver@*.service'

%files
%license LICENSE
%{_bindir}/agelan
%{_prefix}/lib/agelanserver/
%{_datadir}/agelanserver/
%{_docdir}/agelanserver-bin/
%dir %{_sysconfdir}/agelanserver
%config(noreplace) %{_sysconfdir}/agelanserver/config.toml
%{_unitdir}/agelanserver@.service

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1.15.6-1
- Initial package: ageLANServer shared by the AoE/AoM DE packages
