# Age Server (formerly ageLANServer) as a system service, for a machine that
# hosts LAN games.
#   systemctl enable --now agelanserver@age2.service     (age2, age3, athens)
# Players then run `agelan <game>` (or the "(LAN)" menu entry); the launcher
# finds this server through the LAN announcement (UDP 31978) and only joins.
# The server runs its own embedded Battle Server.
[Unit]
Description=Age Server for %i
Documentation=file:///usr/share/doc/agelanserver-bin/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
# The server keeps its certificates, user data (profiles, the matchmaking
# database) and uploaded replays under its own resources directory; give it
# writable directories there. (Certificates moved from %S/agelanserver/%i in
# agelanserver-bin 1.x to its certificates/ subdirectory; genCert makes new
# ones, and the launcher hands players the new CA when they join.)
StateDirectory=agelanserver/%i/certificates agelanserver/%i/userData agelanserver/%i/replays
BindPaths=%S/agelanserver/%i/certificates:/usr/lib/agelanserver/server/resources/certificates
BindPaths=%S/agelanserver/%i/userData:/usr/lib/agelanserver/server/resources/userData
BindPaths=%S/agelanserver/%i/replays:/usr/lib/agelanserver/server/resources/responses/cloud/%i/replays
ExecStartPre=/usr/lib/agelanserver/server/bin/genCert --ignoreIfExisting
ExecStart=/usr/lib/agelanserver/server/server -e %i --config /etc/agelanserver/config.toml
# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
