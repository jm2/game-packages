# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/opt/wreckfest\-gog/.*$
%global __requires_exclude_from ^/opt/wreckfest\-gog/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           wreckfest-wine-gog
Version:        1.0o
Release:        5%{?dist}
Summary:        Wreckfest using Wine with data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/en/game/wreckfest
Source0:       build.sh
Source1:       wreckfest-gog.conf
Source2:       wreckfest-gog.desktop
Source3:       README.md
Source4:       setup_wreckfest_1.0o_(79627).exe
Source5:       setup_wreckfest_1.0o_(79627)-1.bin
Source6:       setup_wreckfest_1.0o_(79627)-2.bin
Source7:       setup_wreckfest_1.0o_(79627)-3.bin
Source8:       setup_wreckfest_1.0o_(79627)-4.bin
Source9:       setup_wreckfest_1.0o_(79627)-5.bin
Source10:      setup_wreckfest_1.0o_(79627)-6.bin
Source11:      setup_wreckfest_1.0o_(79627)-7.bin
Source12:      setup_wreckfest_1.0o_(79627)-8.bin

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  icoutils
BuildRequires:  innoextract
Requires:       gamelaunch >= 1.2.0
Requires:       hicolor-icon-theme
%ifarch aarch64
Requires:       umu-launcher
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       (umu-launcher or wine)
Requires:       wine-ipv6only
%endif
Recommends:     wine

%description
Wreckfest using Wine with data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/wreckfest-gog.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1.0o-5
- Switch to gamelaunch (umu/Proton default, system wine fallback)
- Fix the launcher looking in /opt/wreckfest instead of /opt/wreckfest-gog
- Own prefix, no longer shared with wreckfest-wine-steam
- LAN: run as a Windows user named after the host (unique SteamID per machine); dedicated server variant
- LAN: preload wine-ipv6only so hosting from the game works under Wine (not for -s)
