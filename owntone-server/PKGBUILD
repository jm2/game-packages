# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=owntone-server
pkgver=29.3
pkgrel=2
pkgdesc="DAAP (iTunes), MPD and RSP media server with AirPlay and Chromecast support (formerly forked-daapd)"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/owntone/owntone-server"
license=('GPL-2.0-or-later')
depends=('alsa-lib' 'avahi' 'confuse' 'curl' 'ffmpeg' 'glibc' 'gnutls' 'json-c' 'libevent'
         'libgcrypt' 'libgpg-error' 'libplist' 'libpulse' 'libsodium' 'libunistring'
         'libwebsockets' 'libxml2' 'protobuf-c' 'sqlite' 'util-linux-libs' 'zlib')
backup=('etc/owntone.conf')
# The release tarball ships the generated configure script, parsers and web UI.
source=("${url}/releases/download/${pkgver}/owntone-${pkgver}.tar.xz"
        "install.sh"
        "override.conf"
        "owntone.sysusers"
        "owntone.tmpfiles"
        "README.md")
sha256sums=('aa0cbfc5651aa65776a8bd2112c9e0a904b2185c837900d3f6494b9ec6e8c547'
            '9f65f26b441aa58821a89ef7bd66b496632485e3d58cd7c3364c5473c34782fa'
            '102a179eb7e0c022bf3f8c27656f66ffff0e0b0ae07d65b12d790b9c924f42b0'
            'f3680d2d9fe1616d6c93c848474236b86099e374697f683d7a7fa8f5fde5d0da'
            '42fa5d1a8422483d16678f74053d839d202b5c18e18b7a3e378595771e70430a'
            '60b57b629ae8a899d164f413a966d1886f2e14fe26f600c0b03aeb8c715f0b79')

build() {
  cd "owntone-${pkgver}"
  ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --sbindir=/usr/bin \
    --with-systemddir=/usr/lib/systemd/system \
    --enable-chromecast --with-libwebsockets --with-avahi --with-alsa --with-pulseaudio
  make
}

package() {
  cd "owntone-${pkgver}"
  make DESTDIR="${pkgdir}" install
  sh "${srcdir}/install.sh" "${srcdir}" "${pkgdir}" "${pkgname}"
}
