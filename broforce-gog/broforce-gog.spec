# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/broforce/.*$
%global __requires_exclude_from ^/opt/broforce/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           broforce-gog
Version:        1130_20201008
Release:        4%{?dist}
Summary:        Broforce (native Linux) with data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/broforce
Source0:       build.sh
Source1:       broforce.conf
Source2:       broforce.desktop
Source3:       README.md
Source4:       broforce_1130_20201008_41824.sh

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Requires:       gamelaunch
%ifarch aarch64
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       mesa-libGL
Requires:       libX11
Requires:       libXext
%endif
Provides:       broforce
Conflicts:      broforce-steam

%description
Broforce (native Linux) with data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/broforce.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1130_20201008-4
- Switch to gamelaunch; saves go to a per-user overlay instead of a world-writable /opt/broforce
