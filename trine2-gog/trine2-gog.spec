# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/trine2/.*$
%global __requires_exclude_from ^/opt/trine2/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           trine2-gog
Version:        2.0.0.5
Release:        3%{?dist}
Summary:        Trine 2: Complete Story (native Linux) with data via GOG
License:        LicenseRef-Proprietary
URL:            https://www.gog.com/game/trine_2_complete_story
Source0:       build.sh
Source1:       trine2.conf
Source2:       trine2.desktop
Source3:       README.md
Source4:       gog_trine_2_complete_story_2.0.0.5.sh

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  unzip
Requires:       gamelaunch
Requires:       hicolor-icon-theme
%ifarch aarch64
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       xwininfo
Requires:       mesa-libGLU(x86-32)
Requires:       libXxf86vm(x86-32)
Requires:       openal-soft(x86-32)
Requires:       libX11(x86-32)
Requires:       libdrm(x86-32)
Requires:       libvorbis(x86-32)
Requires:       freetype(x86-32)
Requires:       libogg(x86-32)
Requires:       gtk2(x86-32)
Requires:       gdk-pixbuf2(x86-32)
%endif

%description
Trine 2: Complete Story (native Linux) with data via GOG

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/trine2.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 2.0.0.5-3
- Switch to gamelaunch
