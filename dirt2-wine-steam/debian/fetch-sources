#!/bin/sh
# debian/fetch-sources - fetch the upstream files listed in debian/sources.
#
# Debian source packages here use format "3.0 (native)" and do not carry
# upstream tarballs, so debian/rules calls this before building. Each line of
# debian/sources is "<sha256|-> <filename> <url|local>". Files are looked for,
# in order, next to debian/, in $PT_CACHE/<source package>/, in $PT_CACHE,
# and finally downloaded (unless the url is "local", e.g. GOG installers you
# downloaded yourself).
# Master copy: tools/debian-fetch-sources in jm2/linux-packages.
set -eu
cd "$(dirname "$0")/.."
src=$(sed -n 's/^Source: *//p' debian/control)
[ -f debian/sources ] || exit 0
grep -v '^\s*#' debian/sources | grep -v '^\s*$' | while read -r sum name url; do
    if [ ! -e "$name" ]; then
        for c in "${PT_CACHE:+$PT_CACHE/$src/$name}" "${PT_CACHE:+$PT_CACHE/$name}"; do
            [ -n "$c" ] && [ -e "$c" ] && { ln -s "$c" "$name"; break; }
        done
    fi
    if [ ! -e "$name" ]; then
        if [ "$url" = local ]; then
            echo "fetch-sources: $name is required; place it next to debian/ or in \$PT_CACHE/$src/" >&2
            exit 1
        fi
        echo "fetch-sources: downloading $name" >&2
        curl -fL --retry 3 -o "$name.part" "$url" && mv "$name.part" "$name"
    fi
    if [ "$sum" != - ]; then
        echo "$sum  $name" | sha256sum -c --quiet - || { echo "fetch-sources: checksum mismatch for $name" >&2; exit 1; }
    fi
done
