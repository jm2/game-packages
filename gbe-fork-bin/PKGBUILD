# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=gbe-fork-bin
_tag=release-2026_09_27
pkgver=2026.09.27
pkgrel=2
pkgdesc="Goldberg Steam Emulator (Detanup01/gbe_fork) prebuilt Windows and Linux steam_api for game packages"
arch=('x86_64' 'aarch64')
url="https://github.com/Detanup01/gbe_fork"
license=('LGPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
makedepends=('libarchive')
provides=("gbe-fork=${pkgver}" 'goldberg-emu')
conflicts=('gbe-fork')
options=('!strip' '!debug')
source=("emu-win-release-vs26-${pkgver}.7z::${url}/releases/download/${_tag}/emu-win-release-vs26.7z"
        "emu-linux-release-${pkgver}.tar.bz2::${url}/releases/download/${_tag}/emu-linux-release.tar.bz2"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Detanup01/gbe_fork/${_tag}/LICENSE"
        "install.sh")
noextract=("emu-win-release-vs26-${pkgver}.7z" "emu-linux-release-${pkgver}.tar.bz2")
sha256sums=('417b7d348652ee9c7d2609edc921154cac2c52299975f360f5b04b436ab8c243'
            'f3e08366fb8052e55d9ca29ef5bb1f80afb66d59e96879e5900aac8a6d86c7b9'
            'e3a994d82e644b03a792a930f574002658412f62407f5fee083f2555c5f23118'
            '8ca8d382b33e3ec11459d501b30b415fe4af6500c4550b45e18053649b555af7')

prepare() {
    rm -rf win lin && mkdir win lin
    bsdtar -xf "emu-win-release-vs26-${pkgver}.7z" -C win
    bsdtar -xf "emu-linux-release-${pkgver}.tar.bz2" -C lin
}

package() {
    local _host=x64
    [ "${CARCH}" = aarch64 ] && _host=ARM64
    sh install.sh "${srcdir}/win" "${srcdir}/lin" "${pkgdir}" "${_host}"
    install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
