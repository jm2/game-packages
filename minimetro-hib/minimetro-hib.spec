# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%global __provides_exclude_from ^/opt/minimetro/.*$
%global __requires_exclude_from ^/opt/minimetro/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           minimetro-hib
Version:        57
Release:        1%{?dist}
Summary:        Mini Metro (native Linux) with data via Humble Bundle
License:        LicenseRef-Proprietary
URL:            https://dinopoloclub.com/games/mini-metro/
Source0:       build.sh
Source1:       minimetro.conf
Source2:       minimetro.desktop
Source3:       README.md
Source4:       MiniMetro-release-57-linux.tar.gz

ExclusiveArch:  x86_64 aarch64
BuildRequires:  desktop-file-utils
BuildRequires:  bsdtar
Requires:       gamelaunch
%ifarch aarch64
Requires:       fex-emu
# x86 userland, GL/Vulkan thunks, and the microVM for 16K-page systems
Recommends:     fex-emu-rootfs-fedora
Recommends:     fex-emu-thunks
Recommends:     muvm
%else
Requires:       mesa-libGL
Requires:       libX11
Requires:       libXext
Requires:       mesa-libGLU
%endif
Provides:       minimetro
Conflicts:      minimetro
Conflicts:      minimetro-gog
Conflicts:      minimetro-steam
Obsoletes:      minimetro

%description
Mini Metro, the minimalist subway layout game by Dinosaur Polo Club, from the
DRM-free Linux build in your Humble Bundle library.

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/minimetro.desktop

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 57-1
- Moved into jm2/linux-packages from the AUR minimetro package (release 52)
- Update to release 57; icon from the game, launcher via gamelaunch
