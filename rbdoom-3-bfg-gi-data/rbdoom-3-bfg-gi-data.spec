# Generated by tools/gen.py from package.toml - edit package.toml instead.
# Proprietary game data and prebuilt binaries: no debuginfo, no stripping,
# no automatic library provides/requires from the game tree.
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
# Prebuilt game libraries carry their vendors' build-tree RPATHs.
%global __brp_check_rpaths %{nil}
%global __provides_exclude_from ^/usr/share/games/doom3bfg/.*$
%global __requires_exclude_from ^/usr/share/games/doom3bfg/.*$
# Mostly already-compressed data; fast zstd keeps multi-GB builds reasonable.
%global _binary_payload w3.zstdio

Name:           rbdoom-3-bfg-gi-data
Version:        1.6.0
Release:        2%{?dist}
Summary:        Baked global illumination and blood data for RBDOOM-3-BFG
License:        LicenseRef-Proprietary
URL:            https://github.com/RobertBeckebans/RBDOOM-3-BFG
Source0:       build.sh
Source1:       README.md
Source2:       https://github.com/RobertBeckebans/RBDOOM-3-BFG/releases/download/v1.6.0/RBDOOM-3-BFG-1.6.0.22-full-win64-20250510-git-ba39ba6.7z#/RBDOOM-3-BFG-1.6.0.22-full-win64-20250510-git-ba39ba6.7z

BuildArch:      noarch
BuildRequires:  desktop-file-utils
BuildRequires:  bsdtar
Requires:       rbdoom-3-bfg

%description
The two data packs from RBDOOM-3-BFG's release archive that are not built
from source: _rbdoom_global_illumination_data.pk4, the baked light grids and
environment probes of the Doom 3 BFG campaign maps, and _rbdoom_blood.pk4,
the reflective blood materials those probes were baked for. Installed next
to the retail data in /usr/share/games/doom3bfg/base; extracted at build
time from the upstream Windows release archive (1.6 GB download).

%prep
%setup -q -c -T
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} prepare

%build

%install
PT_SRCDIR=%{_sourcedir} PT_WORK=$PWD/work bash %{SOURCE0} install %{buildroot}

%files -f work/files.list

%changelog
* Mon Nov 02 2026 John-Michael Mulesa <jmulesa@gmail.com> - 1.6.0-2
- Initial package: the data packs of the RBDOOM-3-BFG 1.6.0 release
- Rebuilt without set-group-ID bits on its directories, which made RPM refuse to install it beside its engine package
