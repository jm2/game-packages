# Maintainer: John-Michael Mulesa <jmulesa at gmail dot com>

pkgname=balun-bin
_pkgname=balun
pkgver=0.2.1
pkgrel=2
pkgdesc="A lightweight cross-platform HDHomeRun live TV viewer (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/jm2/balun"
license=('GPL-3.0-or-later')
# gst-plugins-base-libs: playbin3, appsrc, typefind; gst-plugins-bad-libs: tsdemux;
# gst-plugin-gtk4: gtk4paintablesink; gst-libav: MPEG-2/H.264/AC-3/AAC decoders.
depends=('glib2' 'glibc' 'gtk4>=4.16' 'hicolor-icon-theme' 'libadwaita>=1.6' 'libgcc' 'pango'
         'gstreamer>=1.20' 'gst-plugins-base-libs' 'gst-plugins-good' 'gst-plugins-bad-libs'
         'gst-plugin-gtk4' 'gst-libav')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
replaces=("${_pkgname}")
options=('!strip' '!debug')
# Upstream's release packages: its Arch package on x86_64; it publishes none
# for aarch64, so Arch Linux ARM gets the files from its arm64 .deb.
source=("${_pkgname}-${pkgver}-LICENSE::https://raw.githubusercontent.com/jm2/${_pkgname}/v${pkgver}/LICENSE"
        "install.sh"
        "README.md")
source_x86_64=("${_pkgname}-${pkgver}-x86_64.pkg.tar.zst::${url}/releases/download/v${pkgver}/${_pkgname}-x86_64.pkg.tar.zst")
source_aarch64=("${_pkgname}-${pkgver}-arm64.deb::${url}/releases/download/v${pkgver}/${_pkgname}-arm64.deb")
noextract=("${_pkgname}-${pkgver}-x86_64.pkg.tar.zst" "${_pkgname}-${pkgver}-arm64.deb")
sha256sums=('3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986'
            'd69f532b3ca4ba0b5986612c6ffe8e91aae91d31dd37c82f8b62451c37e1aea4'
            '389028271131ee870abc47ae811ce29c5be5ee7fd37079dc5cbdc7d9815631a9')
sha256sums_x86_64=('00facdd70955ee2f68f999d2e3156c71fcb82abc6326946acbfb7910e828a6c8')
sha256sums_aarch64=('6f09888d75e89089cfac2cb180fcaa9459e19163b35752e9e1f2d92ffc0c708a')

prepare() {
  rm -rf root && mkdir root
  case "${CARCH}" in
    x86_64)  bsdtar -xf "${_pkgname}-${pkgver}-x86_64.pkg.tar.zst" -C root usr ;;
    aarch64) bsdtar -xOf "${_pkgname}-${pkgver}-arm64.deb" 'data.tar.*' | bsdtar -xf - -C root ;;
  esac
}

package() {
  sh install.sh "${srcdir}/root" "${pkgdir}" "${pkgname}"
  install -Dm644 "${_pkgname}-${pkgver}-LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
