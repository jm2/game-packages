#!/usr/bin/make -f
# Mirrors the PKGBUILD and balun-bin.spec: keep the three in step.
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
VER := 0.2.1
D := $(CURDIR)/debian/balun-bin

%:
	dh $@

override_dh_auto_build:
	debian/fetch-sources
	# Upstream's release .deb for the host architecture (amd64 or arm64).
	rm -rf root && dpkg-deb -x balun-$(VER)-$(DEB_HOST_ARCH).deb root

override_dh_auto_install:
	sh install.sh root $(D) balun-bin
	desktop-file-validate $(D)/usr/share/applications/io.github.jm2.Balun.desktop

override_dh_auto_test:

# Prebuilt binaries: keep them as upstream shipped them.
override_dh_strip override_dh_dwz override_dh_shlibdeps override_dh_makeshlibs override_dh_strip_nondeterminism:

override_dh_auto_clean:
	rm -rf root
